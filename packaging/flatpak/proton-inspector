#!/bin/sh
set -eu
# Keep removal interactive and separate from the scanner. Do not use --watch-bus:
# the terminal must survive removal of this launcher deployment.
if [ "${1:-}" = "--uninstall" ]; then
    exec /usr/bin/flatpak-spawn --host konsole --separate -e \
        flatpak uninstall --user io.github.inzurgent.ProtonInspector
fi
# Flatpak supplies the host path of this exact installed app deployment.
app_path=$(sed -n 's/^app-path=//p' /.flatpak-info)
if [ -z "$app_path" ]; then
    printf '%s\n' 'Cannot locate the installed Proton Inspector deployment.' >&2
    exit 1
fi
# Host execution is intentional: a sandbox cannot inspect host game processes.
# No elevation or ptrace policy changes are performed.
exec /usr/bin/flatpak-spawn --host --watch-bus \
    "$app_path/lib/proton-inspector/Proton-Inspector-0.1.3-x86_64.AppImage" \
    --appimage-extract-and-run "$@"
