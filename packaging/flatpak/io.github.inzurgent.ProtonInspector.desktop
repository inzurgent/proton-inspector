[Desktop Entry]
Type=Application
Name=Proton Inspector
Comment=Scan and edit numeric values in host Linux and Proton processes
Exec=proton-inspector
Icon=io.github.inzurgent.ProtonInspector
Categories=Development;Utility;
Terminal=false
StartupWMClass=Proton Inspector
Actions=Uninstall;

[Desktop Action Uninstall]
Name=Uninstall Proton Inspector
Icon=edit-delete
Exec=proton-inspector --uninstall
